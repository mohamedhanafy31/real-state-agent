{
  "tests": [
    {
      "id": "single_explicit_code",
      "steps": [
        {
          "user": "عايز تفاصيل الوحدة Hawabay/02/L/304",
          "expected_codes": ["Hawabay/02/L/304"],
          "description": "Exact code lookup should return the matching row (sea-view apartment)."
        }
      ]
    },
    {
      "id": "top3_expensive_apartments",
      "steps": [
        {
          "user": "اديني أغلى 3 شقق عندكم",
          "expected_order": {
            "column": "Price",
            "direction": "desc",
            "limit": 3
          },
          "description": "Selector should sort by price descending and return top 3 units."
        }
      ]
    },
    {
      "id": "cheapest_sea_view_apartment",
      "steps": [
        {
          "user": "أقرب شقة sea view بس تكون سعرها أقل ما يمكن",
          "expected_filters": {
            "Usage": "Apartment",
            "Description_contains_any": ["sea view", "مطل على البحر", "beach view"]
          },
          "expected_order": {
            "column": "Price",
            "direction": "asc",
            "limit": 1
          },
          "description": "Find the cheapest sea-view apartment."
        }
      ]
    },
    {
      "id": "garden_villa_ground_floor",
      "steps": [
        {
          "user": "عايز جاردن فيلا في الدور الأرضي بحديقة كبيرة",
          "expected_filters": {
            "Usage": "Garden Villa",
            "Floor": "Gr",
            "Garden_greater_than": 80
          },
          "description": "Filter ground-floor garden villas with large garden."
        }
      ]
    },
    {
      "id": "conversation_reference_code",
      "steps": [
        {
          "user": "ممكن تشوف لي الشقة Hawabay/06/M/302؟",
          "expected_codes": ["Hawabay/06/M/302"],
          "description": "Initial explicit code lookup."
        },
        {
          "user": "طب اللي قولتلك عليها دي نظام سدادها ايه؟",
          "expected_codes": ["Hawabay/06/M/302"],
          "uses_history": true,
          "description": "Follow-up pronoun reference should reuse the same row."
        }
      ]
    },
    {
      "id": "conversation_top2_then_filter_floor",
      "steps": [
        {
          "user": "هاتلي أغلى شقتين في Hawabay sea view",
          "expected_filters": {
            "Project": "Hawabay",
            "Description_contains_any": ["sea view", "مطل على البحر", "beach view"]
          },
          "expected_order": {
            "column": "Price",
            "direction": "desc",
            "limit": 2
          },
          "description": "Initial request for top 2 sea-view units."
        },
        {
          "user": "الشقة اللي فوق فيهم في دور كام؟ اختار لي اللي في الدور التاني لو موجود.",
          "expected_filters": {
            "Floor": "2nd"
          },
          "uses_history": true,
          "description": "Follow-up referencing previous list by pronoun and applying a floor filter."
        }
      ]
    },
    {
      "id": "conversation_area_reference",
      "steps": [
        {
          "user": "محتاج وحدة حوالي 189 متر",
          "expected_filters": {
            "Area": 189
          },
          "description": "Find units with 189 m² area."
        },
        {
          "user": "اللي قولتلك عليها دي سعرها كام؟",
          "expected_filters": {
            "Area": 189
          },
          "uses_history": true,
          "description": "Follow-up pronoun referencing same area filter."
        }
      ]
    },
    {
      "id": "conversation_same_building_comparison",
      "steps": [
        {
          "user": "هاتلي شقة في مبنى 02/L الدور الأول",
          "expected_filters": {
            "Building": "02/L",
            "Floor": "1st"
          },
          "description": "Initial selection."
        },
        {
          "user": "طيب في شقة في نفس المبنى بس الدور التاني؟",
          "expected_filters": {
            "Building": "02/L",
            "Floor": "2nd"
          },
          "uses_history": true,
          "description": "Follow-up referencing 'same building'."
        },
        {
          "user": "الشقة الأولى مساحتها قد ايه؟",
          "expected_filters": {
            "Building": "02/L",
            "Floor": "1st"
          },
          "uses_history": true,
          "description": "Return to the first mention."
        }
      ]
    },
    {
      "id": "conversation_switch_requirement",
      "steps": [
        {
          "user": "دورلي على شقة حوالى 160 متر",
          "expected_filters": {
            "Area_between": [150, 170]
          },
          "description": "Initial broad area search."
        },
        {
          "user": "لو نفس الشقة فيها جاردن صغير يبقى ممتاز",
          "expected_filters": {
            "Area_between": [150, 170],
            "Garden_greater_than": 0
          },
          "uses_history": true,
          "description": "Add garden constraint referencing same units."
        }
      ]
    },
    {
      "id": "conversation_alias_for_code",
      "steps": [
        {
          "user": "ممكن تفاصيل Hawabay/23/G/1؟",
          "expected_codes": ["Hawabay/23/G/1"],
          "description": "Reference by full code."
        },
        {
          "user": "طيب نرجع للشقة اللي بكود 23 اللي قولتلك عليها",
          "expected_codes": ["Hawabay/23/G/1"],
          "uses_history": true,
          "description": "Follow-up referencing the previously mentioned code by shorthand."
        }
      ]
    }
  ],
